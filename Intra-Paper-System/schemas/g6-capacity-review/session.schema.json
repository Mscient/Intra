{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G6 session v1",
  "description": "Offline diagnostic contract. No identity authentication or scale authority. See G6-CAPACITY-REVIEW.md for semantic constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "date",
    "pilot_id",
    "identity",
    "instruments",
    "classification",
    "status",
    "daily_ops",
    "broker_records",
    "artifacts",
    "tested_conditions",
    "observations",
    "exceptions"
  ],
  "properties": {
    "schema": {
      "const": "g6-session/v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "pilot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/identity"
    },
    "instruments": {
      "$ref": "common.schema.json#/$defs/instruments"
    },
    "classification": {
      "enum": [
        "SYNTHETIC",
        "REPLAY_ONLY",
        "CALLER_SUPPLIED",
        "CLAIMED_LIVE_G5",
        "ESTIMATED",
        "SIMULATED"
      ]
    },
    "status": {
      "enum": [
        "OBSERVED",
        "MISSING",
        "EXCLUDED"
      ]
    },
    "daily_ops": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    },
    "broker_records": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "directory",
          "files"
        ],
        "properties": {
          "kind": {
            "enum": [
              "PORTFOLIO_REPLAY",
              "PORTFOLIO_RISK",
              "PORTFOLIO_SETTLEMENT"
            ]
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "files": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "$ref": "common.schema.json#/$defs/source"
            }
          }
        }
      }
    },
    "tested_conditions": {
      "$ref": "common.schema.json#/$defs/conditions"
    },
    "observations": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value",
          "unit",
          "basis",
          "source"
        ],
        "properties": {
          "metric": {
            "enum": [
              "maximum_order_size",
              "maximum_fill_size",
              "order_count",
              "fill_count",
              "filled_quantity",
              "ordered_quantity",
              "partial_orders",
              "missed_orders",
              "turnover",
              "fees",
              "realized_pnl",
              "unrealized_pnl",
              "drawdown",
              "exposure",
              "participation",
              "fill_ratio",
              "order_rate",
              "slippage",
              "margin_proxy",
              "halts",
              "incidents",
              "operational_exceptions",
              "rejects",
              "cancellations",
              "corrections"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "basis": {
            "enum": [
              "CALLER_SUPPLIED",
              "ESTIMATED",
              "SIMULATED",
              "SYNTHETIC"
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "state": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/source"
          }
        }
      }
    }
  }
}
