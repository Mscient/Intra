{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G6 review report v1",
  "description": "Offline diagnostic only. Byte identity is not source or identity authentication. Semantic constraints are enforced by G6 Java.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "g6_closed",
    "scale_authorized",
    "performance_claim_eligible",
    "diagnostic_only",
    "build",
    "code_sha256",
    "independent_authentication",
    "eligible_live_sessions",
    "eligible_six_calendar_months",
    "verified_tested_envelope",
    "review_id",
    "statistical_estimates",
    "capacity_extrapolations",
    "limits",
    "status",
    "findings",
    "sessions",
    "capacity_scenarios",
    "source_sha256",
    "expected_source_sha256",
    "all_declared_sources_present",
    "observation_units"
