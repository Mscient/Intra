{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G6 authorization v1",
  "description": "Offline diagnostic contract. No identity authentication or scale authority. See G6-CAPACITY-REVIEW.md for semantic constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pilot_id",
    "identity",
    "instruments",
    "valid_from",
    "valid_to_exclusive",
    "source_classification",
    "authorization_evidence",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "g6-authorization/v1"
    },
    "pilot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/identity"
    },
    "instruments": {
      "$ref": "common.schema.json#/$defs/instruments"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "valid_to_exclusive": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_classification": {
      "enum": [
        "SYNTHETIC",
        "REPLAY_ONLY",
        "CALLER_SUPPLIED",
        "CLAIMED_LIVE_G5",
        "ESTIMATED",
        "SIMULATED"
      ]
    },
    "authorization_evidence": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
