{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G6 decision v1",
  "description": "Offline diagnostic contract. No identity authentication or scale authority. See G6-CAPACITY-REVIEW.md for semantic constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "role",
    "identity",
    "qualification_evidence",
    "independence_evidence",
    "reviewed_sha256",
    "report_sha256",
    "build",
    "code_sha256",
    "decision",
    "limitations",
    "reservations",
    "signature",
    "reviewer_decision_sha256"
  ],
  "properties": {
    "schema": {
      "const": "g6-decision/v1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "role": {
      "enum": [
        "owner",
        "reviewer"
      ]
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "qualification_evidence": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "independence_evidence": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "reviewed_sha256": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "ACCEPT_RECOMMENDATION",
        "REJECT_RECOMMENDATION",
        "RECOMMEND_REVIEW",
        "REJECT",
        "RESERVATIONS"
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "reservations": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    },
    "reviewer_decision_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
