{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intra:feed-audit:report:v1",
  "$comment": "Java runtime also enforces interval partitioning, offset/zone consistency, exact identities, hashes, part order, and cross-file constraints.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "feed-audit-report/v1"
      ]
    },
    "audit_version": {
      "enum": [
        "feed-completeness-gap-audit/1"
      ]
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schedule_id": {
      "type": "string",
      "minLength": 1
    },
    "schedule_revision": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "connection_id": {
            "type": "string",
            "minLength": 1
          },
          "subscription_id": {
            "type": "string",
            "minLength": 1
          },
          "exchange": {
            "type": "string",
            "minLength": 1
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "session_date": {
            "type": "string",
            "minLength": 1
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope_id",
          "source",
          "product",
          "channel",
          "connection_id",
          "subscription_id",
          "exchange",
          "token",
          "instrument_id",
          "session_date",
          "timezone"
        ]
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "limits": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "window_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "enum": [
              "INFO",
              "FAIL",
              "INCOMPLETE"
            ]
          },
          "reason_code": {
            "enum": [
              "POLICY_UNRESOLVED",
              "RECEIVE_TIME_REGRESSION",
              "MONOTONIC_REGRESSION",
              "DUPLICATE_PAYLOAD",
              "DECODE_FAILURE",
              "UNKNOWN_INSTRUMENT_OR_TOKEN",
              "EVENT_TIME_UNAVAILABLE",
              "EVENT_TIME_REGRESSION",
              "CLOCK_SKEW_EXCEEDED",
              "STALE_MESSAGE",
              "EVENT_TIME_OUT_OF_WINDOW",
              "MAPPING_TIME_UNAVAILABLE",
              "MAPPING_CHANGED",
              "MAPPING_RESOLVED",
              "MAPPING_FAILURE",
              "RECEIVE_TIME_OUT_OF_WINDOW",
              "UNEXPECTED_EVENT_TYPE",
              "OBSERVED_MESSAGE",
              "SCHEDULE_EXCLUSION",
              "WINDOW_OBSERVATION",
              "NO_MESSAGES_OBSERVED",
              "EVENT_GAP",
              "STALE_INTERVAL",
              "HEARTBEAT_ABSENT",
              "INACTIVE_SUBSCRIPTION",
              "SEQUENCE_UNAVAILABLE",
              "SEQUENCE_GAP",
              "SEQUENCE_RESET",
              "DUPLICATE_SEQUENCE",
              "OUT_OF_ORDER_SEQUENCE",
              "LIFECYCLE_TIME_REGRESSION",
              "LIFECYCLE_MONOTONIC_REGRESSION",
              "SUBSCRIPTION_REJECTED",
              "UNEXPLAINED_DISCONNECT",
              "LIFECYCLE_TRANSITION_ANOMALY",
              "LIFECYCLE_TIMELINE_UNCERTAIN"
            ]
          },
          "start_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "file",
                "row"
              ]
            },
            "minItems": 0
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope_id",
          "window_id",
          "severity",
          "reason_code",
          "start_utc",
          "end_utc",
          "evidence",
          "detail"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "audit_version",
    "code_sha256",
    "schedule_id",
    "schedule_revision",
    "input_sha256",
    "scopes",
    "status",
    "limits",
    "rows"
  ]
}
