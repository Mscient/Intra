{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mscient:intrapaper:g2-admission-input:v1",
  "title": "G2 joined admission input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admission_id",
    "classification",
    "assessment_time_utc",
    "limits",
    "capture",
    "processing",
    "coverage",
    "resources",
    "replay_dataset",
    "feed_audit",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "g2-admission-input/v1"
    },
    "admission_id": {
      "$ref": "#/$defs/id"
    },
    "classification": {
      "enum": [
        "SYNTHETIC",
        "CALLER_DECLARED"
      ]
    },
    "assessment_time_utc": {
      "$ref": "#/$defs/instant"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_resource_bytes",
        "max_evidence_age_seconds",
        "max_future_skew_seconds"
      ],
      "properties": {
        "max_resource_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_evidence_age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_future_skew_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "session_id",
        "process_id",
        "process_epoch",
        "provider_id",
        "source_id",
        "product_id",
        "channel_id",
        "connection_id",
        "subscription_id"
      ],
      "properties": {
        "capture_id": {
          "$ref": "#/$defs/nullableId"
        },
        "session_id": {
          "$ref": "#/$defs/nullableId"
        },
        "process_id": {
          "$ref": "#/$defs/nullableId"
        },
        "process_epoch": {
          "$ref": "#/$defs/nullableId"
        },
        "provider_id": {
          "$ref": "#/$defs/nullableId"
        },
        "source_id": {
          "$ref": "#/$defs/nullableId"
        },
        "product_id": {
          "$ref": "#/$defs/nullableId"
        },
        "channel_id": {
          "$ref": "#/$defs/nullableId"
        },
        "connection_id": {
          "$ref": "#/$defs/nullableId"
        },
        "subscription_id": {
          "$ref": "#/$defs/nullableId"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoder_id",
        "decoder_version",
        "decoder_sha256",
        "schema_id",
        "schema_version",
        "schema_sha256",
        "build_id",
        "build_sha256",
        "decoder_resource_id",
        "schema_resource_id",
        "build_resource_id"
      ],
      "properties": {
        "decoder_id": {
          "$ref": "#/$defs/nullableId"
        },
        "decoder_version": {
          "$ref": "#/$defs/nullableId"
        },
        "decoder_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "schema_id": {
          "$ref": "#/$defs/nullableId"
        },
        "schema_version": {
          "$ref": "#/$defs/nullableId"
        },
        "schema_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "build_id": {
          "$ref": "#/$defs/nullableId"
        },
        "build_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "decoder_resource_id": {
          "$ref": "#/$defs/id"
        },
        "schema_resource_id": {
          "$ref": "#/$defs/id"
        },
        "build_resource_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_start_utc",
        "requested_end_utc",
        "required_start_utc",
        "required_end_utc",
        "observed_start_utc",
        "observed_end_utc",
        "timezone",
        "interval_nanos"
      ],
      "properties": {
        "requested_start_utc": {
          "$ref": "#/$defs/instant"
        },
        "requested_end_utc": {
          "$ref": "#/$defs/instant"
        },
        "required_start_utc": {
          "$ref": "#/$defs/instant"
        },
        "required_end_utc": {
          "$ref": "#/$defs/instant"
        },
        "observed_start_utc": {
          "$ref": "#/$defs/nullableInstant"
        },
        "observed_end_utc": {
          "$ref": "#/$defs/nullableInstant"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "interval_nanos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 9,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "logical_id",
          "role",
          "path",
          "sha256",
          "max_bytes",
          "observed_at_utc",
          "permission"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "logical_id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "RAW_INPUT",
              "LIFECYCLE_INPUT",
              "NORMALIZED_DATA",
              "TOKEN_MAPPING",
              "SESSION_CALENDAR",
              "DECODER",
              "SCHEMA",
              "BUILD",
              "FEED_EVIDENCE",
              "FEED_REFERENCE"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "observed_at_utc": {
            "$ref": "#/$defs/instant"
          },
          "permission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest_path",
              "intended_use_path",
              "evidence_path",
              "as_of"
            ],
            "properties": {
              "manifest_path": {
                "$ref": "#/$defs/path"
              },
              "intended_use_path": {
                "$ref": "#/$defs/path"
              },
              "evidence_path": {
                "$ref": "#/$defs/path"
              },
              "as_of": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "replay_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "normalized_resource_id",
        "normalized_sha256"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/id"
        },
        "dataset_version": {
          "$ref": "#/$defs/id"
        },
        "normalized_resource_id": {
          "$ref": "#/$defs/id"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "feed_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_path",
        "artifact_path",
        "observed_at_utc",
        "schedule_id",
        "schedule_revision"
      ],
      "properties": {
        "evidence_path": {
          "$ref": "#/$defs/path"
        },
        "artifact_path": {
          "$ref": "#/$defs/path"
        },
        "observed_at_utc": {
          "$ref": "#/$defs/instant"
        },
        "schedule_id": {
          "$ref": "#/$defs/id"
        },
        "schedule_revision": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "event_id",
          "domain",
          "event_type",
          "observed_at_utc",
          "event_time_utc",
          "event_time_status",
          "resource_id",
          "record_ordinal",
          "record_sha256",
          "byte_offset",
          "byte_length"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "event_id": {
            "$ref": "#/$defs/id"
          },
          "domain": {
            "enum": [
              "CAPTURE",
              "DECODE",
              "NORMALIZE",
              "MAPPING",
              "SESSION",
              "PERMISSION",
              "REPLAY"
            ]
          },
          "event_type": {
            "$ref": "#/$defs/id"
          },
          "observed_at_utc": {
            "$ref": "#/$defs/instant"
          },
          "event_time_utc": {
            "$ref": "#/$defs/nullableInstant"
          },
          "event_time_status": {
            "enum": [
              "OBSERVED",
              "UNKNOWN"
            ]
          },
          "resource_id": {
            "$ref": "#/$defs/id"
          },
          "record_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "record_sha256": {
            "$ref": "#/$defs/hash"
          },
          "byte_offset": {
            "maximum": 9223372036854775807,
            "type": "integer",
            "minimum": 0
          },
          "byte_length": {
            "maximum": 9223372036854775807,
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableInstant": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$comment": "Runtime additionally enforces canonical UTC, no Windows device aliases, contiguous ordinals, unique identities and paths, 64 MiB total resource limits, semantic joins, permission-before-read and deterministic verification. JSON Schema alone does not admit evidence."
}
