{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mscient:intrapaper:g2-admission-report:v1",
  "title": "G2 joined admission report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admission_version",
    "admission_id",
    "classification",
    "input_manifest_sha256",
    "code_sha256",
    "assessment_time_utc",
    "capture",
    "processing",
    "coverage",
    "resources",
    "permission_decisions",
    "replay_dataset",
    "feed_audit",
    "events",
    "event_domains",
    "unknown_fields",
    "reasons",
    "status",
    "pass_scope",
    "source_authenticity_verified",
    "permission_authenticated",
    "complete_feed_verified",
    "market_correctness_verified",
    "trading_readiness_approved",
    "release_authorized",
    "order_egress_enabled",
    "profitability_established",
    "g2_closed",
    "report_id",
    "normalized_projection_verified",
    "event_semantics_verified",
    "mapping_calendar_authority_verified",
    "control_input_sha256"
  ],
  "properties": {
    "schema": {
      "const": "g2-admission-report/v1"
    },
    "admission_version": {
      "const": "g2-admission/1"
    },
    "admission_id": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "SYNTHETIC",
        "CALLER_DECLARED"
      ]
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assessment_time_utc": {
      "type": "string",
      "format": "date-time"
    },
    "capture": {
      "$ref": "#/$defs/input_capture"
    },
    "processing": {
      "$ref": "#/$defs/input_processing"
    },
    "coverage": {
      "$ref": "#/$defs/input_coverage"
    },
    "resources": {
      "type": "array",
      "minItems": 9,
      "maxItems": 64,
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "order": {
            "maximum": 63,
            "type": "integer",
            "minimum": 0
          },
          "logical_id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "RAW_INPUT",
              "LIFECYCLE_INPUT",
              "NORMALIZED_DATA",
              "TOKEN_MAPPING",
              "SESSION_CALENDAR",
              "DECODER",
              "SCHEMA",
              "BUILD",
              "FEED_EVIDENCE",
              "FEED_REFERENCE"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "declared_sha256": {
            "$ref": "#/$defs/hash"
          },
          "admitted_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "const": "UNKNOWN"
              }
            ]
          },
          "maximum_bytes": {
            "maximum": 16777216,
            "type": "integer",
            "minimum": 1
          },
          "observed_at_utc": {
            "$ref": "#/$defs/instant"
          }
        },
        "required": [
          "order",
          "logical_id",
          "role",
          "path",
          "declared_sha256",
          "admitted_sha256",
          "maximum_bytes",
          "observed_at_utc"
        ]
      }
    },
    "permission_decisions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 64,
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "resource_id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "RAW_INPUT",
              "LIFECYCLE_INPUT",
              "NORMALIZED_DATA",
              "TOKEN_MAPPING",
              "SESSION_CALENDAR",
              "DECODER",
              "SCHEMA",
              "BUILD",
              "FEED_EVIDENCE",
              "FEED_REFERENCE"
            ]
          },
          "decision_id": {
            "$ref": "#/$defs/hash"
          },
          "decision_sha256": {
            "$ref": "#/$defs/hash"
          },
          "status": {
            "enum": [
              "ALLOWED",
              "DENIED",
              "INCOMPLETE"
            ]
          },
          "decision": {
            "type": "object"
          },
          "manifest_path": {
            "$ref": "#/$defs/path"
          },
          "intended_use_path": {
            "$ref": "#/$defs/path"
          },
          "evidence_path": {
            "$ref": "#/$defs/path"
          },
          "observed_dataset_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "const": "UNKNOWN"
              }
            ]
          },
          "dataset_manifest": {
            "$ref": "#/$defs/permission_dataset"
          },
          "dataset_verification": {
            "const": "EXACT_FROZEN_BYTES"
          }
        },
        "required": [
          "resource_id",
          "role",
          "decision_id",
          "decision_sha256",
          "status",
          "decision",
          "manifest_path",
          "intended_use_path",
          "evidence_path",
          "observed_dataset_sha256"
        ]
      }
    },
    "replay_dataset": {
      "$ref": "#/$defs/input_replay_dataset"
    },
    "feed_audit": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE",
            "NOT_RUN",
            "INVALID"
          ]
        },
        "schedule_id": {
          "$ref": "#/$defs/id"
        },
        "schedule_revision": {
          "$ref": "#/$defs/id"
        },
        "report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hash"
        },
        "input_sha256": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        }
      },
      "required": [
        "status",
        "schedule_id",
        "schedule_revision"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "event_id",
          "domain",
          "event_type",
          "observed_at_utc",
          "event_time_utc",
          "event_time_status",
          "resource_id",
          "record_ordinal",
          "record_sha256",
          "byte_offset",
          "byte_length"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "event_id": {
            "$ref": "#/$defs/id"
          },
          "domain": {
            "enum": [
              "CAPTURE",
              "DECODE",
              "NORMALIZE",
              "MAPPING",
              "SESSION",
              "PERMISSION",
              "REPLAY"
            ]
          },
          "event_type": {
            "$ref": "#/$defs/id"
          },
          "observed_at_utc": {
            "$ref": "#/$defs/instant"
          },
          "event_time_utc": {
            "anyOf": [
              {
                "$ref": "#/$defs/instant"
              },
              {
                "const": "UNKNOWN"
              }
            ]
          },
          "event_time_status": {
            "enum": [
              "OBSERVED",
              "UNKNOWN"
            ]
          },
          "resource_id": {
            "$ref": "#/$defs/id"
          },
          "record_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "record_sha256": {
            "$ref": "#/$defs/hash"
          },
          "byte_offset": {
            "maximum": 9223372036854775807,
            "type": "integer",
            "minimum": 0
          },
          "byte_length": {
            "maximum": 9223372036854775807,
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "maxItems": 100000
    },
    "event_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CAPTURE",
          "DECODE",
          "NORMALIZE",
          "MAPPING",
          "SESSION",
          "PERMISSION",
          "REPLAY"
        ]
      }
    },
    "unknown_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "FAIL",
              "INCOMPLETE"
            ]
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "field",
          "detail"
        ]
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "pass_scope": {
      "const": "CONFIGURED_SYNTHETIC_OR_CALLER_DECLARED_CHECKS_ONLY"
    },
    "source_authenticity_verified": {
      "const": false
    },
    "permission_authenticated": {
      "const": false
    },
    "complete_feed_verified": {
      "const": false
    },
    "market_correctness_verified": {
      "const": false
    },
    "trading_readiness_approved": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "order_egress_enabled": {
      "const": false
    },
    "profitability_established": {
      "const": false
    },
    "g2_closed": {
      "const": false
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_projection_verified": {
      "const": false
    },
    "event_semantics_verified": {
      "const": false
    },
    "mapping_calendar_authority_verified": {
      "const": false
    },
    "control_input_sha256": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    }
  },
  "$comment": "The embedded production permission decision is checked by exact deterministic recomputation; issuer identity and permission remain unauthenticated. verify-artifact enforces every nested field by rerunning the production checkers. All report hashes identify bytes only.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableInstant": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "session_id",
        "process_id",
        "process_epoch",
        "provider_id",
        "source_id",
        "product_id",
        "channel_id",
        "connection_id",
        "subscription_id"
      ],
      "properties": {
        "capture_id": {
          "$ref": "#/$defs/nullableId"
        },
        "session_id": {
          "$ref": "#/$defs/nullableId"
        },
        "process_id": {
          "$ref": "#/$defs/nullableId"
        },
        "process_epoch": {
          "$ref": "#/$defs/nullableId"
        },
        "provider_id": {
          "$ref": "#/$defs/nullableId"
        },
        "source_id": {
          "$ref": "#/$defs/nullableId"
        },
        "product_id": {
          "$ref": "#/$defs/nullableId"
        },
        "channel_id": {
          "$ref": "#/$defs/nullableId"
        },
        "connection_id": {
          "$ref": "#/$defs/nullableId"
        },
        "subscription_id": {
          "$ref": "#/$defs/nullableId"
        }
      }
    },
    "input_processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoder_id",
        "decoder_version",
        "decoder_sha256",
        "schema_id",
        "schema_version",
        "schema_sha256",
        "build_id",
        "build_sha256",
        "decoder_resource_id",
        "schema_resource_id",
        "build_resource_id"
      ],
      "properties": {
        "decoder_id": {
          "$ref": "#/$defs/nullableId"
        },
        "decoder_version": {
          "$ref": "#/$defs/nullableId"
        },
        "decoder_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "schema_id": {
          "$ref": "#/$defs/nullableId"
        },
        "schema_version": {
          "$ref": "#/$defs/nullableId"
        },
        "schema_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "build_id": {
          "$ref": "#/$defs/nullableId"
        },
        "build_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "decoder_resource_id": {
          "$ref": "#/$defs/id"
        },
        "schema_resource_id": {
          "$ref": "#/$defs/id"
        },
        "build_resource_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "input_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_start_utc",
        "requested_end_utc",
        "required_start_utc",
        "required_end_utc",
        "observed_start_utc",
        "observed_end_utc",
        "timezone",
        "interval_nanos"
      ],
      "properties": {
        "requested_start_utc": {
          "$ref": "#/$defs/instant"
        },
        "requested_end_utc": {
          "$ref": "#/$defs/instant"
        },
        "required_start_utc": {
          "$ref": "#/$defs/instant"
        },
        "required_end_utc": {
          "$ref": "#/$defs/instant"
        },
        "observed_start_utc": {
          "$ref": "#/$defs/nullableInstant"
        },
        "observed_end_utc": {
          "$ref": "#/$defs/nullableInstant"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "interval_nanos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "input_replay_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "normalized_resource_id",
        "normalized_sha256"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/id"
        },
        "dataset_version": {
          "$ref": "#/$defs/id"
        },
        "normalized_resource_id": {
          "$ref": "#/$defs/id"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "permission_dataset": {
      "additionalProperties": false,
      "properties": {
        "candidate_status": {
          "enum": [
            "CANDIDATE"
          ],
          "type": "string"
        },
        "classification": {
          "enum": [
            "SYNTHETIC",
            "CALLER_DECLARED"
          ],
          "type": "string"
        },
        "data_end": {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "data_start": {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "data_type": {
          "pattern": "^(?!(?:[Aa][Ll][Ll]|[Aa][Nn][Yy]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Pp][Ee][Cc][Ii][Ff][Ii][Ee][Dd]|[Aa][Mm][Bb][Ii][Gg][Uu][Oo][Uu][Ss]|[Tt][Bb][Dd]|[Nn][Oo][Nn][Ee])$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^(?!(?:[Aa][Ll][Ll]|[Aa][Nn][Yy]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Pp][Ee][Cc][Ii][Ff][Ii][Ee][Dd]|[Aa][Mm][Bb][Ii][Gg][Uu][Oo][Uu][Ss]|[Tt][Bb][Dd]|[Nn][Oo][Nn][Ee])$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "dataset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "instruments": {
          "items": {
            "pattern": "^(?!(?:[Aa][Ll][Ll]|[Aa][Nn][Yy]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Pp][Ee][Cc][Ii][Ff][Ii][Ee][Dd]|[Aa][Mm][Bb][Ii][Gg][Uu][Oo][Uu][Ss]|[Tt][Bb][Dd]|[Nn][Oo][Nn][Ee])$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "product_id": {
          "pattern": "^(?!(?:[Aa][Ll][Ll]|[Aa][Nn][Yy]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Pp][Ee][Cc][Ii][Ff][Ii][Ee][Dd]|[Aa][Mm][Bb][Ii][Gg][Uu][Oo][Uu][Ss]|[Tt][Bb][Dd]|[Nn][Oo][Nn][Ee])$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "1"
          ],
          "type": "string"
        },
        "source_id": {
          "pattern": "^(?!(?:[Aa][Ll][Ll]|[Aa][Nn][Yy]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Ss][Pp][Ee][Cc][Ii][Ff][Ii][Ee][Dd]|[Aa][Mm][Bb][Ii][Gg][Uu][Oo][Uu][Ss]|[Tt][Bb][Dd]|[Nn][Oo][Nn][Ee])$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "candidate_status",
        "classification",
        "data_end",
        "data_start",
        "data_type",
        "dataset_id",
        "dataset_sha256",
        "instruments",
        "product_id",
        "schema_version",
        "source_id"
      ],
      "title": "dataset-manifest v1 (additional semantic rules in the preflight guide)",
      "type": "object"
    }
  }
}
